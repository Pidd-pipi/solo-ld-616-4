COMPOSE_PROJECT_NAME=calibration-api
BACKEND_PORT=21116
DB_PORT=54320
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_password
JWT_SECRET=local-dev-secret
# 数据库未就绪/掉线后的后台重试（进程不退出，恢复后自动继续）
DB_CONNECT_RETRY_DELAY_MS=1000
DB_READY_PROBE_INTERVAL_MS=3000
# 幂等占位崩溃接管：持有者失联超过租约后他人可安全接管
IDEMPOTENCY_LEASE_TTL_MS=15000
IDEMPOTENCY_WAIT_TIMEOUT_MS=30000
IDEMPOTENCY_POLL_INTERVAL_MS=200
